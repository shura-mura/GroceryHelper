{
  "Observability": {
    "MinimumLevel": "Information",
    "FrameworkMinimumLevel": "Warning",
    "HostingLifetimeMinimumLevel": "Information",
    "OpenTelemetry": {
      "ConsoleExporter": {
        "Enabled": false
      },
      "FlushTimeoutMilliseconds": 5000
    },
    "File": {
      "Enabled": false,
      "Path": "logs/grocery-helper-.ndjson",
      "RollingInterval": "Day",
      "SizeLimitBytes": 10485760,
      "RollOnFileSizeLimit": true,
      "RetainedFileCount": 7
    }
  }
}
