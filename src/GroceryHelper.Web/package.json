{
  "name": "groceryhelper-web",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": { "node": "22.23.3" },
  "packageManager": "npm@10.9.9",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
